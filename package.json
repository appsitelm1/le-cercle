{
  "name": "le-cercle",
  "version": "0.1.0",
  "private": true,
  "description": "Le Cercle — portail immobilier professionnel",
  "scripts": {
    "dev:web": "pnpm --filter @lecercle/web dev",
    "dev:api": "pnpm --filter @lecercle/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @lecercle/db generate",
    "db:migrate": "pnpm --filter @lecercle/db migrate",
    "db:seed": "pnpm --filter @lecercle/db seed"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
